NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Current Supabase key. The app can temporarily fall back to the legacy
# NEXT_PUBLIC_SUPABASE_ANON_KEY while an existing deployment migrates.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Disabled by default. Set only after the pinned fallback passes the assistant live eval gates.
AI_AGENT_FALLBACK_PROVIDER=
# Live release gates only: groq (default) or openai.
AI_EVAL_PROVIDER=groq
AI_EVAL_REQUEST_INTERVAL_MS=
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
CRON_SECRET=
PLANNER_DATA_MODEL=legacy
# Disabled-by-default M0 rollout flags. Enable independently after local and CI verification.
PLANNER_OPERATION_JOURNAL_CAPTURE=disabled
PLANNER_GENUI_READ_ONLY=disabled
# New authenticated experience shell. Use cohort during private beta; ids are
# Auth owner user ids for the current one-owner-per-workspace model.
PLANNER_UI_V2=disabled
PLANNER_UI_V2_COHORT_OWNER_IDS=
# Release-only local environment values. Do not commit, deploy, or expose these.
# SUPABASE_ACCESS_TOKEN=
# PLANNER_PRODUCTION_DATABASE_URL=
# PLANNER_BACKUP_PASSPHRASE=

# Internal design reference at /preview. Never enable in production.
PLANNER_UI_PREVIEW=disabled
